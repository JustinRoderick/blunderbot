{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/src/index.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@trpc/client": "^11.29.5",
    "@trpc/server": "^11.29.5",
    "better-auth": "^1.7.26",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pg": "^8.14.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.6",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.11",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.8.2"
  }
}
